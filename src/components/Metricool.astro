<section id="analytics-preferences" aria-labelledby="analytics-title" hidden>
<h2 id="analytics-title">Preferencias de analítica</h2>
<p>Con tu permiso, Metricool mide visitas. Puedes rechazar o cambiar tu decisión en cualquier momento.</p>
<button type="button" id="analytics-accept">Aceptar analítica</button>
<button type="button" id="analytics-reject">Rechazar analítica</button>
<a href="/privacy/">Más información</a>
</section>
<button type="button" id="analytics-settings">Preferencias de privacidad</button>
<script is:inline>
(() => {
 const key = 'xemo-analytics-v1';
 const panel = document.getElementById('analytics-preferences');
 const settings = document.getElementById('analytics-settings');
 let choice = null;
 try { choice = localStorage.getItem(key); } catch {}
 let loaded = false;
 function load() {
   if (loaded) return;
   loaded = true;
   const script = document.createElement('script');
   script.src = 'https://tracker.metricool.com/resources/be.js';
   script.onload = () => { if (choice === 'yes' && window.beTracker) window.beTracker.t({hash:'6d69bf49ebf390660f48aab2cca16275'}); };
   document.head.appendChild(script);
 }
 function choose(value) {
   choice = value;
   try { localStorage.setItem(key, value); } catch {}
   panel.hidden = true;
   settings.focus();
   if (value === 'yes') load();
   else if (loaded) location.reload();
 }
 panel.hidden = choice === 'yes' || choice === 'no';
 if (choice === 'yes') load();
 settings.addEventListener('click', () => { panel.hidden = !panel.hidden; if (!panel.hidden) document.getElementById('analytics-accept').focus(); });
 document.getElementById('analytics-accept').addEventListener('click', () => choose('yes'));
 document.getElementById('analytics-reject').addEventListener('click', () => choose('no'));
})();
</script>
<style>
section{padding:16px;border:1px solid #64748b;border-radius:8px;margin:16px 0}button{font:inherit;color:#ffb45d;background:#18283b;border:1px solid #94a3b8;border-radius:6px;padding:8px 12px;margin:4px;cursor:pointer}button:focus-visible{outline:3px solid #ffb45d;outline-offset:3px}
</style>