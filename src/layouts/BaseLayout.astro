---
import Metricool from '../components/Metricool.astro';
const { title = 'XEMO | Ingeniería y tecnología', description = 'Arquitectura, ingeniería de software y aprendizaje continuo.' } = Astro.props;
---
<!doctype html>
<html lang="es"><head><meta charset="utf-8"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://tracker.metricool.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tracker.metricool.com; connect-src 'self' https://tracker.metricool.com; object-src 'none'; base-uri 'self'; form-action 'self'"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="alternate" type="application/rss+xml" title="XEMO Blog" href="/rss.xml"/></head><body><a class="skip" href="#main-content">Saltar al contenido</a><header><a href="/">XEMO.</a><nav aria-label="Navegación principal"><a href="/blog/">Blog</a><a href="/projects/">Proyectos</a><a href="/about/">Sobre mí</a></nav></header><main id="main-content"><slot/></main><footer><a href="https://github.com/ArsenioXemo">GitHub</a> · <a href="/privacy/">Privacidad</a> · <a href="/rss.xml">RSS</a><Metricool /></footer></body></html>
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#0b1423;color:#e8eef6;font:17px/1.7 system-ui,sans-serif}header,main,footer{max-width:1050px;margin:auto;padding:24px}header{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;border-bottom:1px solid #334155}nav{display:flex;gap:18px;flex-wrap:wrap}a{color:#ffb45d;text-underline-offset:4px}header>a{font-size:26px;font-weight:800;text-decoration:none}h1{font-size:clamp(2rem,6vw,4rem);line-height:1.12;letter-spacing:-.04em}h2{line-height:1.3}p{max-width:72ch}main{min-height:70vh}footer{border-top:1px solid #334155;color:#a7b8cc}.eyebrow{color:#ffb45d;font-weight:700;letter-spacing:.1em;font-size:.8rem}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}.card{background:#18283b;border:1px solid #334155;border-radius:12px;padding:22px}.cta{display:inline-block;background:#ffb45d;color:#101722;padding:10px 18px;border-radius:8px;font-weight:700}
.skip{position:absolute;left:12px;top:-100px;background:#ffb45d;color:#101722;padding:8px}.skip:focus{top:8px;z-index:10}a:focus-visible{outline:3px solid #ffb45d;outline-offset:4px}.cards{grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))}
</style>