---
import BaseLayout from '../../layouts/BaseLayout.astro';
const posts = Object.values(import.meta.glob('./*.md', { eager: true }));
---
<BaseLayout title="Blog | XEMO"><h1>Blog</h1><p>Ingeniería, tecnología y experiencia profesional.</p>{posts.length === 0 ? <p>Próximamente: primeros artículos.</p> : <div class="cards">{posts.map((post: any) => <article class="card"><h2><a href={post.url}>{post.frontmatter.title}</a></h2><p>{post.frontmatter.description}</p></article>)}</div>}</BaseLayout>